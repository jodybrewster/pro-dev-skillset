# lead-research — environment
# Copy to .env (gitignored) and fill in. Read from env at runtime; never hardcode keys.

# --- Retrieval: discovery (search) ---
# Required. Free tier at https://serper.dev
SERPER_API_KEY=

# Search provider switch: "serper" (default) or "brave".
# The Brave adapter is a stub today (see scripts/search.mjs) — legal hedge so a client
# engagement can swap providers with one flag once it's implemented.
RESEARCH_SEARCH_PROVIDER=serper
# Required only if RESEARCH_SEARCH_PROVIDER=brave. https://brave.com/search/api/
BRAVE_API_KEY=

# --- Retrieval: read (page -> text/markdown) ---
# Optional. Without a key, r.jina.ai works at lower rate limits. https://jina.ai/reader/
JINA_API_KEY=
# Optional. Fallback reader for JS-heavy / structured-extraction targets.
# Free 500 credits at https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- Retrieval: interactive escalation ---
# agent-browser needs NO key (drives local Chrome). Install: npm i -g agent-browser && agent-browser install
# scripts/browse.sh detects it and degrades gracefully if absent.

# ============================================================================
# DEFERRED — enrichment layer. NOT implemented in this build. Placeholders only.
# Do not add calls to these without an explicit decision; they are paid APIs.
# ============================================================================
# EXA_API_KEY=
# APOLLO_API_KEY=
# PDL_API_KEY=          # People Data Labs
# HUNTER_API_KEY=
