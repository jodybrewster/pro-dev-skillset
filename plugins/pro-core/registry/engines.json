{
  "version": 4,
  "engines": [
    {
      "id": "lavish",
      "owner": "pro-pdd",
      "bridges": [
        "lavish"
      ],
      "kind": "skills-cli",
      "default": true,
      "detect": {
        "all": [
          {
            "file": "skills/lavish/SKILL.md",
            "scopes": [
              "project"
            ]
          }
        ]
      },
      "install": [
        "npx",
        "skills",
        "add",
        "kunchenguid/lavish-axi",
        "--agent",
        "claude-code",
        "-y",
        "--skill",
        "lavish"
      ],
      "update": [
        "npx",
        "skills",
        "add",
        "kunchenguid/lavish-axi",
        "--agent",
        "claude-code",
        "-y",
        "--skill",
        "lavish"
      ],
      "why": "Browser review of plans and specs through the lavish-axi artifact playbooks.",
      "note": "Only the project-local .claude/skills/lavish/SKILL.md counts as installed; a user-scope copy does not satisfy it. The CLI itself runs on demand with npx -y lavish-axi."
    },
    {
      "id": "impeccable",
      "owner": "pro-design",
      "bridges": [
        "impeccable-bridge"
      ],
      "kind": "npx",
      "default": true,
      "detect": {
        "all": [
          {
            "file": "skills/impeccable/SKILL.md",
            "scopes": [
              "project",
              "user"
            ]
          }
        ]
      },
      "install": [
        "npx",
        "impeccable",
        "skills",
        "install"
      ],
      "update": [
        "npx",
        "impeccable",
        "skills",
        "update"
      ],
      "why": "The whole-surface UI and UX design engine that impeccable-bridge routes to.",
      "note": "This is the build compiled for the harness. Never run the shared build (npx skills add pbakaus/impeccable) over a newer harness build, because it tracks npm latest and downgrades."
    },
