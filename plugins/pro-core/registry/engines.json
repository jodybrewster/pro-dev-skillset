    {
      "id": "taste-skill",
      "owner": "pro-design",
      "bridges": [
        "taste-skills-bridge"
      ],
      "kind": "skills-cli",
      "default": false,
      "detect": {
        "all": [
          {
            "file": "skills/design-taste-frontend/SKILL.md",
            "scopes": [
              "project",
              "user"
            ]
          }
        ]
      },
      "install": [
        "npx",
        "skills",
        "add",
        "https://github.com/Leonxlnx/taste-skill",
        "-a",
        "claude-code",
        "-y",
        "-s",
        "*"
      ],
      "update": [
        "npx",
        "skills",
        "add",
        "https://github.com/Leonxlnx/taste-skill",
        "-a",
        "claude-code",
        "-y",
        "-s",
        "*"
      ],
      "why": "Anti-slop frontend generation, visual styles and brand-kit skills from Leonxlnx/taste-skill.",
      "upstream": [
        "gh api repos/Leonxlnx/taste-skill/contents/skills --jq '.[] | select(.type==\"dir\") | .name'",
        "gh api repos/Leonxlnx/taste-skill/contents/skills/<dir>/SKILL.md -H \"Accept: application/vnd.github.raw\" | grep '^name:'"
      ],
      "note": "Upstream folder names do not match install names (brutalist-skill installs as industrial-brutalist-ui), so the upstream catalog is read from each SKILL.md name: line."
    },
